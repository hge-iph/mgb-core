!**************************************************************************************
!						Global configuration parameters
!**************************************************************************************
&mgb_config_global
	
	SIM_START_DATE  = "1979-01-01 00:00" 	!Simulation start date in string format ("YYYY-MM-DD HH:mm").
	SIM_END_DATE    = "1982-08-06 00:00"	!Simulation end date in string format ("YYYY-MM-DD HH:mm")      
	SIM_TIMESTEP 	= 86400.  				!Time step for meteorological forcing (seconds).
    HOTSTART_READ   = 0 					!Hotstart (HS) read configuration: (0) = no HS reading, (1) = read initial conditions from StateVars_WB.hot and StateVars_inertial.hot files.
	HOTSTART_WRITE  = 0			     		!Hotstart (HS) write configuration: (0) = no HS writing, (1) = save MGB state variables at the end of simulation, (2) save MGB state variables for each IT defined in HotstartList.prev (needed for hindcast runs)
		
	SUBASIN_START 	= 1       				!Initial sub-basin for simulation.
	SUBASIN_END   	= 296					!Final sub-basin for simulation.	
	
	N_UNIT_CATCHM 	= 458  	  				!Total number of Unit-catchments. 
	N_HRUS 		  	= 9       				!Total number of Hydrological Response Units.  
	N_SUBASINS    	= 296     				!Total number of sub-basins.    	
	N_CLI_REGIONS 	= 7     				!Number of climate regions.  	
		
	OPT_RES_SUB   	= 0                  	!Option (1) to enable reservoir setup in "SIN_minibacias_lago.txt" file (flow substitution, modification volume-depth-area).  
	N_RES_SUB     	= 0						!Number of reservoirs to be configured in "SIN_minibacias_lago.txt" and "SIN_dados_defluencia.txt".	[OPT_RES_SUB] option must be set to 1
	  	
&end
!**************************************************************************************
!	  				Input forcing parameters
!**************************************************************************************
&mgb_config_forcing

	TS_TEMP	= 0								!Flag for using (1) time series or (0) monthly means for temperature (ºC)
	TS_RAD 	= 0								!Flag for using (1) time series or (0) monthly means for radiation (MJ/m² per time step)
	TS_RH 	= 0								!Flag for using (1) time series or (0) monthly means for relative humidity (%)
	TS_WIND = 0								!Flag for using (1) time series or (0) monthly means for wind speed at 10m (m/s)
	TS_PRES = 0								!Flag for using (1) time series or (0) monthly means for atmospheric pressure (kPa)		
	OPT_MONTH_RAD = 1    					!Options for radiation in monthly climatological data: (0) = sunshine hours (INMET), (1) = sunshine percent (CRU), (2) = radiation (WorldClim v2.1).    

&end
!**************************************************************************************
!							 River routing parameters
!**************************************************************************************
&mgb_config_routing

	OPT_ROUTING = 1					    	!Flag for routing mode: (0) = Muskingum-Cunge, (1) = Local inertial (hydrodynamic). 
	N_THREADS = 1 							!Number of CPU threads that will be used for OMP parallelization (inertial routing). 
		
	IN_DOWN_SLOPE = 0.0						!Downstream boundary condition for inertial routing (m/km).
	IN_COURANT_ALPHA = 0.3    				!Alpha for Courant-Friedrich-Levy (CFL) condition. Lower values improve model stability by reducing time step, but increase computational burden.                          

&end
!**************************************************************************************
!							 Output variables
!**************************************************************************************
!Set flag to save (1) or not (0) simulation outputs on disk
&mgb_config_output

    OUT_FLOW	   = 1 						!River discharge (m³/s)     
    OUT_WSE        = 0 						!Water surface elevation (m)
    OUT_HAND       = 0 						!Water level rescaled to Hand Above Nearest Discharge (m)
    OUT_TWS        = 0 						!Terrestrial Water Storage (mm)
    OUT_SM         = 0 						!Soil water content (mm)
	OUT_SSAT       = 0 						!Soil saturation degree (0-1)
    OUT_RUNOFF     = 0 						!Total runoff (mm)
    OUT_SURFWAT    = 0 						!Surface Water Volume (mm)
    OUT_ET         = 0 						!Total Evapotranspiration (mm)
    OUT_ETINT      = 0 						!Evaporation of intercepted water (mm)
    OUT_ETSOILVEG  = 0 						!Evapotranspiration from soil + vegetation (mm)
    OUT_ETOPENWAT  = 0 						!Evaporation from dynamic open waters (mm)
    OUT_ETURHWAT   = 0 						!Evaporation from HRU Water (mm)
    OUT_VBAS       = 0 						!Groundwater reservoir volume (mm)
    OUT_VINT       = 0 						!Subsurface reservoir volume (mm)
    OUT_VSUP       = 0 						!Surface reservoir volume (mm) 
    OUT_VINTERC    = 0 						!Volume of intercepted water in canopy (mm)
    OUT_DBAS       = 0 						!Groundwater flux from soil (mm)
    OUT_DINT       = 0 						!Subsurface flux from soil (mm)
    OUT_DSUP       = 0 						!Surface flux from soil (mm) 
	OUT_FLAREA     = 0						!Flooded area (km²)

&end




